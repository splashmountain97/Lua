# PostHog project API key. This is a public, write-only key — it is meant to
# ship in the client bundle and cannot read anything back.
#
# Without it the app runs exactly as it does today and sends nothing: see the
# note at the top of src/lib/analytics.ts for what is and is not collected.
#
# Get one at https://eu.posthog.com → Settings → Project → Project API key.
VITE_POSTHOG_KEY=

# Defaults to the EU cloud. Set only if the project lives elsewhere.
# VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Supabase, for the premium wall's waitlist. Without these the address is kept
# on the device instead and nothing is sent anywhere.
VITE_SUPABASE_URL=

# The PUBLISHABLE key — it starts sb_publishable_ (or, on the older format, the
# anon key starting eyJ). It is compiled into the public bundle, which is safe
# only because the table's row-level security lets it insert and nothing else.
#
# Never put the sb_secret_ key here. It bypasses row-level security entirely,
# and in this file it would ship to every visitor with full read and delete of
# the table.
VITE_SUPABASE_PUBLISHABLE_KEY=
