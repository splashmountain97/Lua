# PostHog project API key. This is a public, write-only key — it is meant to
# ship in the client bundle and cannot read anything back.
#
# Without it the app runs exactly as it does today and sends nothing: see the
# note at the top of src/lib/analytics.ts for what is and is not collected.
#
# Get one at https://eu.posthog.com → Settings → Project → Project API key.
VITE_POSTHOG_KEY=

# Defaults to the EU cloud. Set only if the project lives elsewhere.
# VITE_POSTHOG_HOST=https://eu.i.posthog.com
